# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
# Both Agent A and Agent B will use this same API key but with DIFFERENT models:
# - Agent A (YC Partner): gpt-4o (more powerful, aggressive)
# - Agent B (Senior Engineer): gpt-4o-mini (efficient, technical)
# - Judge: gpt-4o (synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# Server Port (optional, defaults to 3001)
PORT=3001
