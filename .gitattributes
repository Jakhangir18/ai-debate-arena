# Auto detect text files and perform LF normalization
* text=auto

# TypeScript
*.ts text eol=lf
*.tsx text eol=lf

# JavaScript
*.js text eol=lf
*.jsx text eol=lf

# JSON
*.json text eol=lf

# CSS
*.css text eol=lf

# HTML
*.html text eol=lf

# Markdown
*.md text eol=lf

# Configuration files
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Exclude from exports
.env export-ignore
.git export-ignore
node_modules export-ignore
dist export-ignore
